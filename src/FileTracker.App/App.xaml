<Application x:Class="FileTracker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FileTracker.App"
             xmlns:converters="clr-namespace:FileTracker.App.Converters">
    <Application.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolInvertVisibilityConverter x:Key="BoolInvertVisibilityConverter" />
        <converters:BoolInvertConverter x:Key="BoolInvertConverter" />
    </Application.Resources>
</Application>
