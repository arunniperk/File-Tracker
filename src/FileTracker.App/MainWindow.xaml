<Window x:Class="FileTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileTracker.App"
        xmlns:views="clr-namespace:FileTracker.App.Views"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="File Tracker — IIT Dharwad Registrar Office"
        Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ HEADER ═══════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,16">
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="IIT DHARWAD" FontSize="11" FontWeight="Bold"
                               Foreground="#5A7599"
                               FontFamily="{StaticResource HeadingFont}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="FILE TRACKER" FontSize="22" FontWeight="Bold"
                                   Foreground="White" FontFamily="{StaticResource HeadingFont}" />
                        <Border Background="{StaticResource AccentBrush}" CornerRadius="3"
                                Padding="6,2" Margin="12,6,0,0" VerticalAlignment="Center">
                            <TextBlock Text="REGISTRAR OFFICE" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryColor}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Backup" Style="{StaticResource AccentButton}"
                            Command="{Binding BackupCommand}" Margin="0,0,8,0" />
                    <Button Content="Restore" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RestoreCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════ TABS ═══════════════════════ -->
        <TabControl Grid.Row="1" x:Name="MainTabs"
                     SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="Dashboard">
                <views:DashboardView DataContext="{Binding DashboardVm}" />
            </TabItem>
            <TabItem Header="Documents">
                <Grid Background="{StaticResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="File Number"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            <TextBox Grid.Row="1" Grid.Column="0"
                                     Text="{Binding SearchVm.SearchFileNumber, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Tracking ID"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     Text="{Binding SearchVm.SearchTrackingId, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Subject"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            <TextBox Grid.Row="1" Grid.Column="4"
                                     Text="{Binding SearchVm.SearchSubject, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Sender / Recipient"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                            <TextBox Grid.Row="1" Grid.Column="6"
                                     Text="{Binding SearchVm.SearchSenderRecipient, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Row="1" Grid.Column="8" Orientation="Horizontal">
                                <Button Content="Search" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SearchVm.SearchCommand}"
                                        Width="90" IsDefault="True" Margin="0,0,8,0" />
                                <Button Content="Clear" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding SearchVm.ClearSearchCommand}"
                                        Width="60" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Registration Form -->
                    <views:RegisterDocumentView Grid.Row="1"
                                                 x:Name="RegisterDocumentViewControl" />

                    <!-- DataGrid + Pagination -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding SearchVm.SearchResults}"
                                  SelectedItem="{Binding SelectedDocument}"
                                  AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tracking ID" Binding="{Binding TrackingId}" Width="100" />
                                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="55" />
                                <DataGridTextColumn Header="File Number" Binding="{Binding OriginalFileNumber}" Width="120" />
                                <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="200" />
                                <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="100" />
                                <DataGridTextColumn Header="Sender / Recipient" Binding="{Binding Sender}" Width="150" />
                                <DataGridTextColumn Header="Current Location" Binding="{Binding CurrentLocation}" Width="140" />
                                <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                                <DataGridTemplateColumn Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource PrimaryButton}"
                                                        FontSize="11" Padding="8,4" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.RecordMovementCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="->" FontSize="12" Margin="0,0,4,0" />
                                                        <TextBlock Text="Move" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="View" FontSize="11" Padding="8,4"
                                                        Margin="0,0,4,0"
                                                        Command="{Binding DataContext.OpenDocumentDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Style="{StaticResource SecondaryButton}"
                                                        Content="Edit" FontSize="11" Padding="8,4"
                                                        Command="{Binding DataContext.EditDocumentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Pagination -->
                        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Previous" Style="{StaticResource SecondaryButton}"
                                        FontSize="12" Width="90"
                                        Command="{Binding SearchVm.PreviousPageCommand}"
                                        IsEnabled="{Binding SearchVm.HasPreviousPage}" />
                                <Border Background="{StaticResource SurfaceAltBrush}"
                                        CornerRadius="4" Padding="16,8" Margin="12,0"
                                        MinWidth="160">
                                    <TextBlock Text="{Binding SearchVm.PageIndicator}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </Border>
                                <Button Content="Next" Style="{StaticResource SecondaryButton}"
                                        FontSize="12" Width="90"
                                        Command="{Binding SearchVm.NextPageCommand}"
                                        IsEnabled="{Binding SearchVm.HasNextPage}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ═══════════════════════ FOOTER ═══════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource PrimaryBrush}" Padding="12,6">
            <Grid>
                <TextBlock Text="IIT Dharwad • File Tracker v1.0"
                           Foreground="#5A7599" FontSize="11"
                           HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Manage Positions" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenManagePositionsCommand}"
                            FontSize="11" Padding="8,4" Foreground="#AABBCC"
                            Background="#1A3350" BorderThickness="0"
                            Margin="0,0,8,0" />
                    <Button Content="Reports" Style="{StaticResource SecondaryButton}"
                            Command="{Binding OpenReportWindowCommand}"
                            FontSize="11" Padding="8,4" Foreground="#AABBCC"
                            Background="#1A3350" BorderThickness="0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
