<Window x:Class="FileTracker.App.Views.RecordMovementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FileTracker.App.Converters"
        Title="{Binding WindowTitle}" Height="440" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- Header -->
        <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                Padding="12,8" Margin="0,0,0,16">
            <TextBlock Foreground="White" FontWeight="Bold" FontSize="14">
                <Run Text="Document: " />
                <Run Text="{Binding Document.Subject}" FontWeight="Normal" />
            </TextBlock>
        </Border>

        <!-- From Position -->
        <TextBlock Text="From Position" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4" />
        <ComboBox ItemsSource="{Binding Positions}"
                  SelectedItem="{Binding SelectedFromPosition}"
                  DisplayMemberPath="Name" Margin="0,0,0,12" />

        <!-- To Position -->
        <TextBlock Text="To Position" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4" />
        <ComboBox ItemsSource="{Binding Positions}"
                  SelectedItem="{Binding SelectedToPosition}"
                  DisplayMemberPath="Name" Margin="0,0,0,12" />

        <!-- Direction + Date -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Direction" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <ComboBox SelectedValue="{Binding DirectionText}">
                    <ComboBoxItem Content="Sent" />
                    <ComboBoxItem Content="Received" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Date" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <DatePicker SelectedDate="{Binding MovementDate}" />
            </StackPanel>
        </Grid>

        <!-- Remarks -->
        <TextBlock Text="Remarks" FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,4" />
        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"
                 Margin="0,0,0,12" />

        <!-- Error -->
        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                   Margin="0,0,0,8" TextWrapping="Wrap" />

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save Movement" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" IsDefault="True" Margin="0,0,8,0"
                    MinWidth="120" />
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                    IsCancel="True" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
