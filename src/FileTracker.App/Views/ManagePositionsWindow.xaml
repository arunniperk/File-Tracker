<Window x:Class="FileTracker.App.Views.ManagePositionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FileTracker.App.Converters"
        Title="Manage Positions" Height="520" Width="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource BodyFont}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolToStatusConverter x:Key="BoolToStatus" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,12">
            <TextBlock Text="Officer Positions" FontSize="16" FontWeight="Bold"
                       Foreground="White" />
        </Border>

        <!-- Add Form -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="+ Add Position" Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddPositionCommand}" Margin="0,0,8,0" MinWidth="110" />
            <TextBox Text="{Binding NewPositionName, UpdateSourceTrigger=PropertyChanged}"
                     Width="220" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                       VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Rename Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                Padding="8" Margin="0,0,0,8"
                Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Rename:" VerticalAlignment="Center" Margin="0,0,8,0"
                           FontWeight="SemiBold" FontSize="12" />
                <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}"
                         Width="200" VerticalAlignment="Center" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveRenameCommand}" Margin="8,0,4,0"
                        FontSize="12" Padding="8,4" />
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelRenameCommand}" FontSize="12" Padding="8,4" />
            </StackPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Positions}"
                  SelectedItem="{Binding SelectedPosition}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Order" Binding="{Binding DisplayOrder}" Width="55" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170" />
                <DataGridTextColumn Header="Status" Binding="{Binding IsActive, Converter={StaticResource BoolToStatus}}" Width="80" />
                <DataGridTemplateColumn Header="Actions" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Rename" Style="{StaticResource SecondaryButton}"
                                        FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                        Command="{Binding DataContext.StartRenameCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Up" Style="{StaticResource SecondaryButton}"
                                        FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                        Command="{Binding DataContext.MoveUpCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Down" Style="{StaticResource SecondaryButton}"
                                        FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                        Command="{Binding DataContext.MoveDownCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Deactivate" Style="{StaticResource SecondaryButton}"
                                        FontSize="11" Padding="6,3"
                                        Command="{Binding DataContext.DeactivateCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
