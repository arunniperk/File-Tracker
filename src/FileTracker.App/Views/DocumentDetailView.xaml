<UserControl x:Class="FileTracker.App.Views.DocumentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FileTracker.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="550">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolInvertVisibilityConverter x:Key="BoolInvertVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Header -->
            <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                    Padding="14,10" Margin="0,0,0,16">
                <TextBlock Text="Document Details" FontSize="16" FontWeight="Bold"
                           Foreground="White" />
            </Border>

            <!-- Metadata Cards -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tracking ID" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDocument.TrackingId}"
                               FontSize="13" Margin="0,6" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Direction" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDocument.Direction}"
                               FontSize="13" Margin="0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="File Number" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedDocument.OriginalFileNumber}"
                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                               FontSize="13" Margin="0,6" />
                    <TextBox Grid.Row="2" Grid.Column="1"
                             Text="{Binding EditOriginalFileNumber, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Subject" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedDocument.Subject}"
                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                               FontSize="13" Margin="0,6" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding EditSubject, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Date" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedDocument.DocumentDate, StringFormat={}{0:dd MMM yyyy}}"
                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                               FontSize="13" Margin="0,6" />
                    <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding EditDocumentDate}"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Remarks" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedDocument.Remarks}"
                               Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                               FontSize="13" Margin="0,6" TextWrapping="Wrap" />
                    <TextBox Grid.Row="5" Grid.Column="1"
                             Text="{Binding EditRemarks, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" />

                    <!-- Buttons -->
                    <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Edit" Style="{StaticResource PrimaryButton}"
                                Command="{Binding EnterEditModeCommand}" FontSize="12" Padding="12,6"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="Save Changes" Style="{StaticResource AccentButton}"
                                Command="{Binding SaveEditCommand}" FontSize="12" Padding="12,6"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                Margin="0,0,8,0" />
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelEditCommand}" FontSize="12" Padding="12,6"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                               Margin="0,4,0,0" />
                </Grid>
            </Border>

            <!-- Attachments -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Attachments" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8" />
                    <Button Content="+ Add Attachment" Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddAttachmentCommand}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Attachments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4"
                                        Padding="8,6" Margin="0,2">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock Text="📄" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12">
                                                <Run Text="{Binding FileName}" FontWeight="SemiBold" />
                                                <Run Text="{Binding FileSize, StringFormat=' ({0:N0} bytes)'}"
                                                     FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Open" Style="{StaticResource SecondaryButton}"
                                                    FontSize="11" Padding="6,3" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                                    FontSize="11" Padding="6,3"
                                                    Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Audit Trail -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Edit History" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding AuditEntries}"
                              AutoGenerateColumns="False" IsReadOnly="True" Height="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Timestamp" Binding="{Binding ChangedAt, StringFormat={}{0:dd-MMM-yyyy HH:mm}}" Width="135" />
                            <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="100" />
                            <DataGridTextColumn Header="Old Value" Binding="{Binding OldValue}" Width="140" />
                            <DataGridTextColumn Header="New Value" Binding="{Binding NewValue}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Movement History -->
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Padding="16">
                <StackPanel>
                    <TextBlock Text="Movement History" Style="{StaticResource HeadingSmall}" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding MovementHistory}"
                              AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding MovementDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="100" />
                            <DataGridTextColumn Header="From" Binding="{Binding FromPositionName}" Width="130" />
                            <DataGridTextColumn Header="To" Binding="{Binding ToPositionName}" Width="130" />
                            <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="70" />
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
