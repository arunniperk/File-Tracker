<UserControl x:Class="FileTracker.App.Views.DocumentDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FileTracker.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="500">
    <UserControl.Resources>
         <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolInvertVisibilityConverter x:Key="BoolInvertVisibilityConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </UserControl.Resources>
    <Border Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="8">
        <StackPanel>
            <TextBlock Text="Document Details" FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <!-- Metadata section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Tracking ID (read-only) -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tracking ID:" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedDocument.TrackingId}" Margin="0,4" />

                <!-- Direction (read-only) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Direction:" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedDocument.Direction}" Margin="0,4" />

                <!-- File Number -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="File Number:" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding SelectedDocument.OriginalFileNumber}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                           Margin="0,4" />
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding EditOriginalFileNumber, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,4" Padding="4" />

                <!-- Subject -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Subject:" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding SelectedDocument.Subject}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                           Margin="0,4" />
                <TextBox Grid.Row="3" Grid.Column="1"
                         Text="{Binding EditSubject, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,4" Padding="4" />

                <!-- Sender (incoming) / Recipient (outgoing) -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Sender:" FontWeight="SemiBold" Margin="0,4"
                           Visibility="{Binding SelectedDocument.Sender, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding SelectedDocument.Sender}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                           Margin="0,4" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding EditSender, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,4" Padding="4" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Recipient:" FontWeight="SemiBold" Margin="0,4"
                           Visibility="{Binding SelectedDocument.Recipient, Converter={StaticResource StringToVisibilityConverter}}" />
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding SelectedDocument.Recipient}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                           Margin="0,4" />
                <TextBox Grid.Row="4" Grid.Column="1"
                         Text="{Binding EditRecipient, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,4" Padding="4" />

                <!-- Date -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="Date:" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding SelectedDocument.DocumentDate, StringFormat={}{0:dd-MMM-yyyy}}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                           Margin="0,4" />
                <DatePicker Grid.Row="5" Grid.Column="1"
                            SelectedDate="{Binding EditDocumentDate}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,4" />

                <!-- Remarks -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="Remarks:" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="6" Grid.Column="1"
                           Text="{Binding SelectedDocument.Remarks}"
                           Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                           Margin="0,4" TextWrapping="Wrap" />
                <TextBox Grid.Row="6" Grid.Column="1"
                         Text="{Binding EditRemarks, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                         Margin="0,4" Padding="4"
                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="40" />

                <!-- Created At (read-only) -->
                <TextBlock Grid.Row="7" Grid.Column="0" Text="Created:" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="7" Grid.Column="1"
                           Text="{Binding SelectedDocument.CreatedAt, StringFormat={}{0:dd-MMM-yyyy HH:mm}}"
                           Margin="0,4" />

                <!-- Error message -->
                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="Red"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                           Margin="0,4" TextWrapping="Wrap" />

                <!-- Buttons -->
                <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Edit"
                            Command="{Binding EnterEditModeCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVisibilityConverter}}"
                            Padding="16,8" MinWidth="80" Margin="0,0,8,0" />
                    <Button Content="Save"
                            Command="{Binding SaveEditCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="16,8" MinWidth="80" Margin="0,0,8,0" />
                    <Button Content="Cancel"
                            Command="{Binding CancelEditCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                            Padding="16,8" MinWidth="80" />
                </StackPanel>
            </Grid>

            <!-- Attachments Section -->
            <TextBlock Text="Attachments" FontSize="16" FontWeight="SemiBold"
                       Margin="0,24,0,8" />
            <Button Content="+ Add Attachment" Command="{Binding AddAttachmentCommand}"
                    Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,4" />
            <ItemsControl ItemsSource="{Binding Attachments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="4" Margin="0,2" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center">
                                    <Run Text="{Binding FileName}" FontWeight="SemiBold" />
                                    <Run Text="{Binding FileSize, StringFormat=' ({0:N0} bytes)'}" FontSize="11" Foreground="Gray" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Open" Padding="8,2" Margin="4,0"
                                        Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="2" Content="Remove" Padding="8,2"
                                        Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Audit Trail Section -->
            <TextBlock Text="Edit History" FontSize="16" FontWeight="SemiBold"
                       Margin="0,24,0,8" />

            <DataGrid ItemsSource="{Binding AuditEntries}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      Height="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp"
                                        Binding="{Binding ChangedAt, StringFormat={}{0:dd-MMM-yyyy HH:mm}}"
                                        Width="140" />
                    <DataGridTextColumn Header="Field Changed"
                                        Binding="{Binding FieldName}"
                                        Width="120" />
                    <DataGridTextColumn Header="Old Value"
                                        Binding="{Binding OldValue}"
                                        Width="150" />
                    <DataGridTextColumn Header="New Value"
                                        Binding="{Binding NewValue}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- Movement History Section -->
            <TextBlock Text="Movement History" FontSize="16" FontWeight="SemiBold"
                       Margin="0,24,0,8" />

            <DataGrid ItemsSource="{Binding MovementHistory}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"
                                        Binding="{Binding MovementDate, StringFormat={}{0:dd-MMM-yyyy}}"
                                        Width="100" />
                    <DataGridTextColumn Header="From"
                                        Binding="{Binding FromPositionName}"
                                        Width="130" />
                    <DataGridTextColumn Header="To"
                                        Binding="{Binding ToPositionName}"
                                        Width="130" />
                    <DataGridTextColumn Header="Direction"
                                        Binding="{Binding Direction}"
                                        Width="80" />
                    <DataGridTextColumn Header="Remarks"
                                        Binding="{Binding Remarks}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</UserControl>
