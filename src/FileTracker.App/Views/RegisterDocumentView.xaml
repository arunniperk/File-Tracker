<UserControl x:Class="FileTracker.App.Views.RegisterDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FileTracker.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="500">
    <UserControl.Resources>
        <converters:BoolInvertConverter x:Key="InverseBoolConverter" />
    </UserControl.Resources>
    <Border Padding="16" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="8">
        <StackPanel>
            <!-- Mode indicator (D-08: detail panel separate from registration) -->
            <TextBlock Text="{Binding ModeIndicator}" FontSize="18" FontWeight="SemiBold"
                       Margin="0,0,0,16" />

            <!-- Incoming / Outgoing Toggle (D-04) — disabled in edit mode -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                        IsEnabled="{Binding IsEditMode, Converter={StaticResource InverseBoolConverter}}">
                <RadioButton Content="Incoming" IsChecked="{Binding IsIncoming}"
                             GroupName="Direction" Margin="0,0,16,0" />
                <RadioButton Content="Outgoing"
                             IsChecked="{Binding IsIncoming, Converter={StaticResource BoolInvertConverter}}"
                             GroupName="Direction" Margin="0,0,0,0" />
            </StackPanel>

            <!-- Sender / Recipient field (label swaps based on IsIncoming) -->
            <TextBlock Text="Sender"
                       Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="0,4,0,2" />
            <TextBlock Text="Recipient"
                       Visibility="{Binding IsIncoming, Converter={StaticResource BoolInvertVisibilityConverter}}"
                       Margin="0,4,0,2" />
            <TextBox Text="{Binding SenderOrRecipient, UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                     Margin="0,0,0,8" Padding="4" />

            <!-- Subject -->
            <TextBlock Text="Subject" Margin="0,4,0,2" />
            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                     Margin="0,0,0,8" Padding="4" />

            <!-- Date -->
            <TextBlock Text="Date" Margin="0,4,0,2" />
            <DatePicker SelectedDate="{Binding DocumentDate}"
                        Margin="0,0,0,8" />

            <!-- File Number -->
            <TextBlock Text="File Number" Margin="0,4,0,2" />
            <TextBox Text="{Binding OriginalFileNumber, UpdateSourceTrigger=PropertyChanged,
                                   ValidatesOnDataErrors=True, NotifyOnValidationError=True}"
                     Margin="0,0,0,8" Padding="4" />

            <!-- Remarks -->
            <TextBlock Text="Remarks" Margin="0,4,0,2" />
            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,8" Padding="4"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     MinHeight="60" />

            <!-- Error message -->
            <TextBlock Text="{Binding ErrorMessage}" Foreground="Red"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"
                       Margin="0,4,0,8" TextWrapping="Wrap" />

            <!-- Save button -->
            <Button Command="{Binding SubmitCommand}"
                    Margin="0,8,0,0" Padding="16,8"
                    HorizontalAlignment="Left" MinWidth="100">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Content" Value="Save" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Content" Value="Save Changes" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
