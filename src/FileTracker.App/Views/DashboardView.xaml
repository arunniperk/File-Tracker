<UserControl x:Class="FileTracker.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FileTracker.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- Header -->
                <RowDefinition Height="Auto" />  <!-- Pending by Officer -->
                <RowDefinition Height="Auto" />  <!-- Recent Documents -->
                <RowDefinition Height="*" />     <!-- Overdue Documents -->
            </Grid.RowDefinitions>

            <!-- ═══ Header ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="Operational Dashboard"
                               FontSize="20" FontWeight="Bold" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="Gray">
                        <Run Text="Last updated: " />
                        <Run Text="{Binding LastUpdated, StringFormat={}{0:dd-MMM-yyyy HH:mm:ss}}" />
                    </TextBlock>
                </StackPanel>
                <Button Content="↻ Refresh" Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="80" Height="28" />
            </Grid>

            <!-- ═══ Section 1: Pending by Officer ═══ -->
            <GroupBox Grid.Row="1" Header="Documents Pending at Officers"
                      Margin="0,0,0,8"
                      Visibility="{Binding HasPending, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding PendingByOfficer}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F0F4F8" CornerRadius="4"
                                    Padding="8,6" Margin="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding OfficerName}"
                                                   FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="#1A5276" Margin="12,0">
                                        <Run Text="{Binding DocumentCount}" />
                                        <Run Text=" docs" FontSize="12" FontWeight="Normal" />
                                    </TextBlock>

                                    <Button Grid.Column="2" Content="View →"
                                            Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.NavigateToOfficerCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <!-- ═══ Section 2: Recent Documents ═══ -->
            <GroupBox Grid.Row="2" Header="Recently Registered (Last 7 Days)"
                      Margin="0,0,0,8"
                      Visibility="{Binding HasRecent, Converter={StaticResource CountToVisibility}}">
                <DataGrid ItemsSource="{Binding RecentDocuments}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" MaxHeight="200"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tracking ID" Binding="{Binding TrackingId}" Width="110" />
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="220" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110" />
                        <DataGridTextColumn Header="Current Location" Binding="{Binding CurrentLocation}" Width="150" />
                        <DataGridTextColumn Header="Sender" Binding="{Binding Sender}" Width="*" />
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Padding="4,2"
                                            Command="{Binding DataContext.OpenDocumentCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- ═══ Section 3: Overdue Documents ═══ -->
            <GroupBox Grid.Row="3" Margin="0,0,0,8"
                      Visibility="{Binding HasOverdue, Converter={StaticResource CountToVisibility}}">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠ Overdue — Action Required"
                                   Foreground="Red" FontWeight="Bold" FontSize="13" />
                        <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="Gray"
                                   VerticalAlignment="Center">
                            <Run Text="(" />
                            <Run Text="{Binding OverdueDocuments.Count, Mode=OneWay}" />
                            <Run Text=" stalled)" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox.Header>

                <DataGrid ItemsSource="{Binding OverdueDocuments}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column"
                          Margin="4">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="#FFF5F5" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tracking ID" Binding="{Binding TrackingId}" Width="110" />
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="80" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="220" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110" />
                        <DataGridTextColumn Header="Current Location" Binding="{Binding CurrentLocation}" Width="150" />
                        <DataGridTextColumn Header="Sender" Binding="{Binding Sender}" Width="*" />
                        <DataGridTemplateColumn Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Open" Padding="4,2"
                                            Command="{Binding DataContext.OpenDocumentCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

        </Grid>
    </ScrollViewer>
</UserControl>
