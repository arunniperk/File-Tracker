<UserControl x:Class="FileTracker.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:FileTracker.App.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Operational Dashboard"
                               Style="{StaticResource HeadingLarge}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}">
                        <Run Text="Last refreshed: " />
                        <Run Text="{Binding LastUpdated, StringFormat={}{0:dd MMM yyyy, HH:mm}}" />
                    </TextBlock>
                </StackPanel>
                <Button Style="{StaticResource SecondaryButton}"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Width="90" />
            </Grid>

            <!-- Stats Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" Padding="20" Margin="0,0,10,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="PENDING" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding PendingByOfficer.Count}"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Officers with pending work" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" Padding="20" Margin="5,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="RECENT" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding RecentDocuments.Count}"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource InfoColor}" Margin="0,4,0,0" />
                        <TextBlock Text="Documents this week" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}"
                        CornerRadius="8" Padding="20" Margin="10,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="OVERDUE" FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="{Binding OverdueDocuments.Count}"
                                   FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                        <TextBlock Text="Stalled over 7 days" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Pending by Officer -->
            <GroupBox Grid.Row="2" Header="Pending by Officer"
                      Margin="0,0,0,20"
                      Visibility="{Binding HasPending, Converter={StaticResource CountToVisibility}}">
                <ItemsControl ItemsSource="{Binding PendingByOfficer}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    CornerRadius="6" Padding="16,12" Margin="4"
                                    Width="220" Cursor="Hand"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding OfficerName}"
                                               FontWeight="SemiBold" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="1" FontSize="28" FontWeight="Bold"
                                               Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,0">
                                        <Run Text="{Binding DocumentCount}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" Text="pending documents"
                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                    <Button Grid.RowSpan="3" Style="{StaticResource SecondaryButton}"
                                            Content="View" FontSize="10" Padding="6,4"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Command="{Binding DataContext.NavigateToOfficerCommand,
                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <!-- Recent Documents -->
            <GroupBox Grid.Row="3" Header="Recently Registered"
                      Margin="0,0,0,20"
                      Visibility="{Binding HasRecent, Converter={StaticResource CountToVisibility}}">
                <DataGrid ItemsSource="{Binding RecentDocuments}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="250">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tracking ID" Binding="{Binding TrackingId}" Width="110" />
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="70" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="250" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110" />
                        <DataGridTextColumn Header="Location" Binding="{Binding CurrentLocation}" Width="150" />
                        <DataGridTextColumn Header="Sender/Recipient" Binding="{Binding Sender}" Width="*" />
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Open" FontSize="11" Padding="6,3"
                                            Command="{Binding DataContext.OpenDocumentCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Overdue -->
            <GroupBox Grid.Row="4" Margin="0,0,0,20"
                      Visibility="{Binding HasOverdue, Converter={StaticResource CountToVisibility}}">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OVERDUE" Foreground="{StaticResource DangerBrush}"
                                   FontWeight="Bold" FontSize="12" />
                        <TextBlock Margin="8,0,0,0" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="(" />
                            <Run Text="{Binding OverdueDocuments.Count, Mode=OneWay}" />
                            <Run Text=" stalled)" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox.Header>
                <DataGrid ItemsSource="{Binding OverdueDocuments}"
                          AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource DangerBgBrush}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tracking ID" Binding="{Binding TrackingId}" Width="110" />
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="70" />
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="250" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DocumentDate, StringFormat={}{0:dd-MMM-yyyy}}" Width="110" />
                        <DataGridTextColumn Header="Location" Binding="{Binding CurrentLocation}" Width="150" />
                        <DataGridTextColumn Header="Sender/Recipient" Binding="{Binding Sender}" Width="*" />
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Content="Open" FontSize="11" Padding="6,3"
                                            Command="{Binding DataContext.OpenDocumentCommand,
                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

        </Grid>
    </ScrollViewer>
</UserControl>
