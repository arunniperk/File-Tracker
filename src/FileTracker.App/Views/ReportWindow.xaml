<Window x:Class="FileTracker.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monthly Report" Height="340" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource BodyFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                Padding="14,10" Margin="0,0,0,16">
            <TextBlock Text="Monthly Report Generator" FontSize="16" FontWeight="Bold"
                       Foreground="White" />
        </Border>

        <!-- Month -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Month" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Months}"
                      SelectedValue="{Binding SelectedMonth}"
                      SelectedValuePath="Number" DisplayMemberPath="Name" />
        </Grid>

        <!-- Year -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Year" VerticalAlignment="Center" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Years}"
                      SelectedItem="{Binding SelectedYear}" />
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Preview" Style="{StaticResource SecondaryButton}"
                    Command="{Binding PreviewCommand}" Width="85" Margin="0,0,8,0" />
            <Button Content="Export PDF" Style="{StaticResource AccentButton}"
                    Command="{Binding GeneratePdfCommand}" Width="100" Margin="0,0,8,0" />
            <Button Content="Export Excel" Style="{StaticResource PrimaryButton}"
                    Command="{Binding GenerateExcelCommand}" Width="100" />
        </StackPanel>

        <!-- Progress -->
        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <ProgressBar IsIndeterminate="{Binding IsGenerating}" Height="6"
                         Margin="0,0,0,10" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"
                       Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"
                       FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
