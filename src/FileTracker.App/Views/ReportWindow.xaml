<Window x:Class="FileTracker.App.Views.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generate Monthly Report" Height="350" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Monthly Report Generator"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,12" />

        <!-- Month Selection -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Month:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Months}"
                      SelectedValue="{Binding SelectedMonth}"
                      SelectedValuePath="Number"
                      DisplayMemberPath="Name" />
        </Grid>

        <!-- Year Selection -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Year:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Years}"
                      SelectedItem="{Binding SelectedYear}" />
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Content="Preview" Command="{Binding PreviewCommand}"
                    Width="90" Margin="0,0,8,0" />
            <Button Content="Export PDF" Command="{Binding GeneratePdfCommand}"
                    Width="90" Margin="0,0,8,0" FontWeight="SemiBold" />
            <Button Content="Export Excel" Command="{Binding GenerateExcelCommand}"
                    Width="90" FontWeight="SemiBold" />
        </StackPanel>

        <!-- Progress indicator -->
        <ProgressBar Grid.Row="4" IsIndeterminate="{Binding IsGenerating}"
                     Height="16" Margin="0,0,0,8" />

        <!-- Status message -->
        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" Foreground="DarkBlue" />
    </Grid>
</Window>
