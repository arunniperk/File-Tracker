<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="File Tracker"
           Manufacturer="IIT Dharwad"
           Version="1.0.0"
           UpgradeCode="A1B2C3D4-E5F6-7890-ABCD-EF1234567890"
           Scope="perMachine"
           Language="1033"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="File Tracker" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="File Tracker" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="B1C2D3E4-F5A6-7890-BCDE-F12345678901">
        <Shortcut Id="DesktopSC" Name="File Tracker"
                  Target="[INSTALLFOLDER]FileTracker.App.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\IITDharwad\FileTracker"
                       Name="installed" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Files Include="..\publish\FileTracker\**">
        <Exclude Files="..\publish\FileTracker\*.pdb" />
      </Files>
    </ComponentGroup>
  </Package>
</Wix>
